# Optional runtime envs (global config in ~/.cat-crawl/config.json is preferred)
# Required for current app flow: default Obsidian vault selector (name / id / absolute path)
OBSIDIAN_VAULT=知识库
OBSIDIAN_FOLDER=Clippings
# Optional: global candidates for dynamic_folder (split by ",").
# Example: AI学习法技能提升,产品增长,编程前端
OBSIDIAN_DYNAMIC_FOLDERS=
MAX_TOOL_STEPS=4

# Optional transcription runtime settings
TRANSCRIPTION_PROVIDER=whisper_cpp
TRANSCRIPTION_FALLBACK_PROVIDER=gemini
WHISPER_CPP_BIN=whisper-cli
WHISPER_CPP_MODEL_PATH=
WHISPER_CPP_LANGUAGE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Optional: Douyin cookie string for Playwright-based extraction
DOUYIN_COOKIE=
