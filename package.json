{
  "name": "cat-crawl-workspace",
  "version": "0.1.0",
  "description": "Crawl WeChat articles and save them to Obsidian with multi-channel bot interfaces.",
  "private": true,
  "type": "module",
  "bin": {
    "cat-crawl": "./bin/cat-crawl.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx apps/cli/src/index.ts",
    "dev:feishu": "tsx apps/cli/src/index.ts obsidian start --feishu",
    "dev:telegram": "tsx apps/cli/src/index.ts obsidian start --telegram",
    "dev:discord": "tsx apps/cli/src/index.ts obsidian start --discord",
    "dev:all": "tsx apps/cli/src/index.ts obsidian start --all-channels",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "start": "node dist/apps/cli/src/index.js",
    "test": "tsx --test src/**/*.test.ts apps/**/*.test.ts packages/**/*.test.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@cat-crawl/case-study": "workspace:*",
    "@cat-crawl/core": "workspace:*",
    "@cat-crawl/obsidian-publisher": "workspace:*",
    "@langchain/core": "^1.1.29",
    "@langchain/openai": "^1.2.11",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "better-sqlite3": "^12.6.2",
    "discord.js": "^14.25.1",
    "playwright": "^1.58.2",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.3.3",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "wechat",
    "telegram",
    "discord",
    "obsidian",
    "crawler"
  ],
  "license": "MIT"
}
