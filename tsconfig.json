{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "apps",
    "packages"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "apps/**/*.test.ts",
    "packages/**/*.test.ts"
  ]
}
